# ─── EmailJS configuration ──────────────────────────────────────────────────
# Copy this file to `.env` (or `.env.local`) and fill in your own values.
# These are read by src/siteScript.js. If left unset, the app falls back to the
# original placeholder values and EmailJS stays disabled (the contact form then
# uses its mailto fallback) — exactly like the original static site.
#
# HOW TO GET THESE (free):
# 1. https://www.emailjs.com  → create an account
# 2. Add an Email Service (e.g. Gmail) → copy the Service ID
# 3. Create a Template (vars: {{from_name}} {{from_email}} {{company}} {{interest}} {{message}})
#    → copy the Template ID
# 4. Account → API Keys → copy the Public Key
#
# NOTE: Vite only exposes variables prefixed with VITE_ to the browser.
# The EmailJS public key is a client-side key (safe to ship); it is not a secret.

VITE_EMAILJS_SERVICE_ID=arpitrautela01@indorsetech.com
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
